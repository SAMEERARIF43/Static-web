  // Listeners
  document.getElementById('detail-back').addEventListener('click', () => history.back() || navigate('home'));
  document.getElementById('detail-watch-btn').addEventListener('click', () => navigate('watch', { id, ep: 1 }));

  const wlBtn = document.getElementById('detail-watchlist-btn');
  wlBtn.addEventListener('click', () => {
    toggleWatchlist(id);
    wlBtn.textContent = isInWatchlist(id) ? '🔖 In Watchlist' : '🔖 Add to Watchlist';
  });

  container.querySelectorAll('.episode-item[data-ep]').forEach(el => {
    el.addEventListener('click', () => navigate('watch', { id, ep: +el.dataset.ep }));
    el.addEventListener('keydown', e => { if (e.key === 'Enter') navigate('watch', { id, ep: +el.dataset.ep }); });
  });

  const recoGrid = container.querySelector('.reco-grid');
  if (recoGrid) attachCardListeners(recoGrid);
  attachNavListeners(container);
}

// ────────────────────────────────────────────────────────────
// RENDER: WATCH PAGE
// ────────────────────────────────────────────────────────────
function renderWatchPage(id, epNum = 1) {
  State.currentAnimeId = id;
  State.currentEpisode = epNum;
  addToContinue(id, epNum);
  renderContinueWatching(); // update home section silently

  const anime = getAnimeById(id);
  const container = document.getElementById('watch-layout');

  if (!anime) {
    container.innerHTML = `<div class="empty-state" style="padding-top:120px"><div class="empty-icon">😕</div><h3>Anime Not Found</h3><button class="cta-btn primary-btn" data-nav="home">Home</button></div>`;
    attachNavListeners(container);
    return;
  }

  const episodes = getEpisodes(anime);
  const ep = episodes.find(e => e.number === epNum) || episodes[0];
  const recommendations = getRecommendations(id, 4);

  container.innerHTML = `
    <div class="watch-main">
      <button class="back-btn" id="watch-back">← Back to Details</button>
      <div class="video-player">
        <div class="video-placeholder">
          <div class="video-placeholder-icon">▶</div>
          <div class="video-placeholder-text">${anime.title}</div>
          <div class="video-placeholder-sub">Episode ${ep.number} · ${ep.duration}</div>
        </div>
      </div>
      <div class="watch-info">
        <h2 class="watch-title">${anime.title}</h2>
        <p class="watch-episode-name">Episode ${ep.number}: ${ep.title}</p>
        <div class="watch-controls">
          <button class="watch-ctrl-btn" id="prev-ep" ${ep.number <= 1 ? 'disabled' : ''}>
            ← Previous
          </button>
          <button class="watch-ctrl-btn" id="next-ep" ${ep.number >= episodes.length ? 'disabled' : ''}>
            Next →
          </button>
          <button class="watch-ctrl-btn" id="watch-add-wl" data-watchlist-id="${anime.id}">
            🔖 ${isInWatchlist(id) ? 'In Watchlist' : 'Add to Watchlist'}
          </button>
        </div>
      </div>
    </div>

    <div class="watch-sidebar">
      <div>
        <h3 class="sidebar-section-title">Episode List</h3>
        <div class="sidebar-episode-list">
          ${episodes.map(e => `
            <div class="sidebar-ep-item${e.number === ep.number ? ' active' : ''}"
                 data-ep="${e.number}" role="button" tabindex="0">
              <span class="sidebar-ep-num">Ep ${e.number}</span>
              <div class="sidebar-ep-info">
                <div class="sidebar-ep-title">${e.title}</div>
                <div class="sidebar-ep-dur">${e.duration}</div>
              </div>
            </div>`).join('')}
          ${anime.episodes > 24 ? `<div class="sidebar-ep-item" style="opacity:0.5;cursor:default;justify-content:center">+ ${anime.episodes - 24} more…</div>` : ''}
        </div>
      </div>
      <div>
        <h3 class="sidebar-section-title">You May Also Like</h3>
        ${recommendations.map(a => `
          <div class="watch-reco-card" data-id="${a.id}" role="button" tabindex="0">
            <img class="watch-reco-img" src="${a.poster}" alt="${a.title}"
                 onerror="this.src='https://placehold.co/80x110/0d1117/ff7200?text=AH'">
            <div class="watch-reco-info">
              <div class="watch-reco-title">${a.title}</div>
              <div class="watch-reco-meta">⭐ ${a.rating} · ${a.type}</div>
              <div class="watch-reco-btn">Watch Now →</div>
            </div>
          </div>`).join('')}
      </div>
    </div>`;

  // Back button
  document.getElementById('watch-back').addEventListener('click', () => navigate('detail', { id }));

  // Episode nav
  document.getElementById('prev-ep')?.addEventListener('click', () => navigate('watch', { id, ep: ep.number - 1 }));
  document.getElementById('next-ep')?.addEventListener('click', () => navigate('watch', { id, ep: ep.number + 1 }));

  // Watchlist
  const wlBtn = document.getElementById('watch-add-wl');
  wlBtn.addEventListener('click', () => {
    toggleWatchlist(id);
    wlBtn.textContent = `🔖 ${isInWatchlist(id) ? 'In Watchlist' : 'Add to Watchlist'}`;
  });

  // Sidebar episodes
  container.querySelectorAll('.sidebar-ep-item[data-ep]').forEach(el => {
    el.addEventListener('click', () => navigate('watch', { id, ep: +el.dataset.ep }));
    el.addEventListener('keydown', e => { if (e.key === 'Enter') navigate('watch', { id, ep: +el.dataset.ep }); });
  });

  // Reco cards
  container.querySelectorAll('.watch-reco-card[data-id]').forEach(el => {
    el.addEventListener('click', () => navigate('detail', { id: +el.dataset.id }));
    el.addEventListener('keydown', e => { if (e.key === 'Enter') navigate('detail', { id: +el.dataset.id }); });
  });
}

// ────────────────────────────────────────────────────────────
// CARD EVENT DELEGATION
// ────────────────────────────────────────────────────────────
function attachCardListeners(container) {
  container.addEventListener('click', e => {
    // Watchlist button
    const wlBtn = e.target.closest('.card-watchlist-btn');
    if (wlBtn) {
      e.stopPropagation();
      const id = +wlBtn.dataset.watchlistId;
      toggleWatchlist(id);
      // If on watchlist page, re-render
      if (State.currentPage === 'watchlist') renderWatchlistPage();
      return;
    }

    // Play button
    const playBtn = e.target.closest('.play-btn');
    if (playBtn) {
      e.stopPropagation();
      const card = playBtn.closest('.anime-card');
      if (card) navigate('watch', { id: +card.dataset.id, ep: 1 });
      return;
    }

    // Card click → detail
    const card = e.target.closest('.anime-card');
    if (card) navigate('detail', { id: +card.dataset.id });
  });

  // Keyboard
  container.addEventListener('keydown', e => {
    if (e.key === 'Enter') {
      const card = e.target.closest('.anime-card');
      if (card) navigate('detail', { id: +card.dataset.id });
    }
  });
}

// Attach nav listeners to arbitrary containers (detail/watch empty states)
function attachNavListeners(container) {
  container.querySelectorAll('[data-nav]').forEach(el => {
    el.addEventListener('click', e => {
      e.preventDefault();
      navigate(el.dataset.nav);
    });
  });
}

// ────────────────────────────────────────────────────────────
// SEARCH
// ────────────────────────────────────────────────────────────
function doSearch(query) {
  const q = (query || '').trim();
  if (!q) return;
  closeSearchOverlay();
  navigate('search', { query: q });
}

function renderSearchOverlayResults(query) {
  const resultsEl = document.getElementById('search-results');
  const q = (query || '').trim();
  if (!q) {
    resultsEl.innerHTML = '<p class="search-hint">Start typing to search anime…</p>';
    return;
  }
  const results = searchAnime(q);
  if (!results.length) {
    resultsEl.innerHTML = `<p class="search-no-results">No results for "<b>${q}</b>". Try a different keyword.</p>`;
    return;
  }
  resultsEl.innerHTML = `
    <div class="search-results-grid">
      ${results.slice(0, 8).map(a => buildCard(a)).join('')}
    </div>`;
  attachCardListeners(resultsEl);
}

function openSearchOverlay() {
  const overlay = document.getElementById('search-overlay');
  overlay.classList.add('open');
  setTimeout(() => document.getElementById('search-overlay-input')?.focus(), 100);
}

function closeSearchOverlay() {
  document.getElementById('search-overlay').classList.remove('open');
  document.getElementById('search-overlay-input').value = '';
  document.getElementById('search-results').innerHTML = '';
}

// ────────────────────────────────────────────────────────────
// MOBILE MENU
// ────────────────────────────────────────────────────────────
function closeMobileMenu() {
  document.getElementById('mobile-menu')?.classList.remove('active');
  document.getElementById('nav-links')?.classList.remove('open');
}

// ────────────────────────────────────────────────────────────
// NAVBAR SCROLL
// ────────────────────────────────────────────────────────────
function initNavbar() {
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar.classList.toggle('scrolled', window.scrollY > 60);
  }, { passive: true });
}

// ────────────────────────────────────────────────────────────
// INIT — wire up all global events
// ────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  initNavbar();

  // ── NAV LINKS (desktop + mobile) ──
  document.querySelectorAll('[data-nav]').forEach(el => {
    el.addEventListener('click', e => {
      e.preventDefault();
      navigate(el.dataset.nav);
    });
  });

  // ── MOBILE HAMBURGER ──
  const hamburger = document.getElementById('mobile-menu');
  const navLinksList = document.getElementById('nav-links');
  hamburger?.addEventListener('click', () => {
    hamburger.classList.toggle('active');
    navLinksList.classList.toggle('open');
  });
  hamburger?.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' ') hamburger.click();
  });

  // Close menu on backdrop click
  document.addEventListener('click', e => {
    if (navLinksList.classList.contains('open') &&
        !navLinksList.contains(e.target) &&
        !hamburger.contains(e.target)) {
      closeMobileMenu();
    }
  });

  // ── SEARCH TRIGGER ──
  document.getElementById('nav-search-trigger')?.addEventListener('click', openSearchOverlay);
  document.getElementById('search-close-btn')?.addEventListener('click', closeSearchOverlay);

  // Overlay input – live results
  let searchDebounce;
  document.getElementById('search-overlay-input')?.addEventListener('input', e => {
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(() => renderSearchOverlayResults(e.target.value), 200);
  });
  document.getElementById('search-overlay-input')?.addEventListener('keydown', e => {
    if (e.key === 'Enter') doSearch(e.target.value);
    if (e.key === 'Escape') closeSearchOverlay();
  });

  // ── HERO SEARCH ──
  document.getElementById('hero-search-btn')?.addEventListener('click', () => {
    doSearch(document.getElementById('hero-search-input')?.value);
  });
  document.getElementById('hero-search-input')?.addEventListener('keydown', e => {
    if (e.key === 'Enter') doSearch(e.target.value);
  });

  // ── TOP SEARCH TAGS ──
  document.getElementById('top-search-tags')?.addEventListener('click', e => {
    const tag = e.target.closest('.tag');
    if (tag && tag.dataset.search) doSearch(tag.dataset.search);
  });

  // ── CLOSE SEARCH OVERLAY ON ESCAPE (global) ──
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeSearchOverlay();
  });

  // ── INITIAL RENDER ──
  renderHome();
  document.getElementById('page-home').classList.add('active');
});
