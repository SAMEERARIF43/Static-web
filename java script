'use strict';

// ────────────────────────────────────────────────────────────
// STATE
// ────────────────────────────────────────────────────────────
const State = {
  currentPage: 'home',
  currentAnimeId: null,
  currentEpisode: 1,
  watchlist: JSON.parse(localStorage.getItem('ah_watchlist') || '[]'),
  continueWatching: JSON.parse(localStorage.getItem('ah_continue') || '[]'),
  activeGenre: 'All',
  searchQuery: '',
};

// ────────────────────────────────────────────────────────────
// UTILITIES
// ────────────────────────────────────────────────────────────
function saveWatchlist() {
  localStorage.setItem('ah_watchlist', JSON.stringify(State.watchlist));
}

function saveContinue() {
  localStorage.setItem('ah_continue', JSON.stringify(State.continueWatching));
}

function isInWatchlist(id) {
  return State.watchlist.includes(id);
}

function toggleWatchlist(id) {
  const anime = getAnimeById(id);
  if (!anime) return;
  if (isInWatchlist(id)) {
    State.watchlist = State.watchlist.filter(i => i !== id);
    showToast(`Removed "${anime.title}" from watchlist`, 'info');
  } else {
    State.watchlist.push(id);
    showToast(`Added "${anime.title}" to watchlist ✓`, 'success');
  }
  saveWatchlist();
  // Refresh watchlist badge on any visible buttons
  document.querySelectorAll(`[data-watchlist-id="${id}"]`).forEach(btn => {
    btn.classList.toggle('saved', isInWatchlist(id));
    btn.title = isInWatchlist(id) ? 'Remove from Watchlist' : 'Add to Watchlist';
    btn.textContent = isInWatchlist(id) ? '🔖' : '🔖';
  });
}

function addToContinue(animeId, episode) {
  State.continueWatching = State.continueWatching.filter(i => i.id !== animeId);
  State.continueWatching.unshift({ id: animeId, ep: episode, progress: 60 });
  if (State.continueWatching.length > 6) State.continueWatching.pop();
  saveContinue();
}

// ────────────────────────────────────────────────────────────
// TOAST
// ────────────────────────────────────────────────────────────
let toastTimer = null;
function showToast(message, type = 'info') {
  const toast = document.getElementById('toast');
  const icons = { success: '✅', error: '❌', info: 'ℹ️' };
  toast.innerHTML = `<span>${icons[type] || ''}</span><span>${message}</span>`;
  toast.className = `toast ${type} show`;
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove('show'), 3200);
}

// ────────────────────────────────────────────────────────────
// ROUTER — navigate between pages
// ────────────────────────────────────────────────────────────
function navigate(page, payload = {}) {
  // Hide all pages
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));

  // Update nav highlight
  document.querySelectorAll('.nav-link').forEach(a => {
    a.classList.toggle('active', a.dataset.nav === page);
  });

  // Close mobile menu
  closeMobileMenu();

  State.currentPage = page;
  window.scrollTo({ top: 0, behavior: 'smooth' });

  switch (page) {
    case 'home':      renderHome(); break;
    case 'popular':   renderPopularPage(); break;
    case 'movies':    renderMoviesPage(); break;
    case 'series':    renderSeriesPage(); break;
    case 'watchlist': renderWatchlistPage(); break;
    case 'search':    renderSearchPage(payload.query); break;
    case 'detail':    renderDetailPage(payload.id); break;
    case 'watch':     renderWatchPage(payload.id, payload.ep); break;
    default:          renderHome();
  }

  document.getElementById(`page-${page}`)?.classList.add('active');
}

// ────────────────────────────────────────────────────────────
// CARD HTML BUILDER
// ────────────────────────────────────────────────────────────
function buildCard(anime, opts = {}) {
  const saved = isInWatchlist(anime.id);
  const badgeText = anime.status === 'Completed' ? 'Completed' : `Ep ${anime.episodes}`;
  const badgeClass = anime.status === 'Completed' ? 'card-badge completed' : 'card-badge';

  return `
    <div class="anime-card" data-id="${anime.id}" role="button" tabindex="0" aria-label="${anime.title}">
      <div class="card-image-wrapper" ${opts.progress ? `style="--progress:${opts.progress}%"` : ''}>
        <img class="card-image"
             src="${anime.poster}"
             alt="${anime.title}"
             loading="lazy"
             onerror="this.src='https://placehold.co/300x450/0d1117/ff7200?text=${encodeURIComponent(anime.title)}'">
        <div class="card-overlay">
          <button class="play-btn" aria-label="Play ${anime.title}">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </button>
        </div>
        <span class="${badgeClass}">${badgeText}</span>
        <button class="card-watchlist-btn ${saved ? 'saved' : ''}"
                data-watchlist-id="${anime.id}"
                title="${saved ? 'Remove from Watchlist' : 'Add to Watchlist'}"
                aria-label="Toggle watchlist for ${anime.title}">🔖</button>
      </div>
      <div class="card-info">
        <h3 class="card-title">${anime.title}</h3>
        <div class="card-meta">
          <span class="card-rating"><span class="star">⭐</span> ${anime.rating}</span>
          <span class="card-type">${anime.type}</span>
        </div>
      </div>
    </div>`;
}

// Render a grid of skeleton loading cards
function buildSkeletons(count = 5) {
  return Array.from({ length: count }, () => `
    <div class="skeleton-card">
      <div class="skeleton skeleton-img"></div>
      <div class="skeleton skeleton-title"></div>
      <div class="skeleton skeleton-meta"></div>
    </div>`).join('');
}

// ────────────────────────────────────────────────────────────
// GENRE FILTER BUILDER
// ────────────────────────────────────────────────────────────
function buildGenreFilter(containerId, onSelect) {
  const bar = document.getElementById(containerId);
  if (!bar) return;
  const allGenres = ['All', ...ALL_GENRES];
  bar.innerHTML = allGenres.map(g =>
    `<button class="genre-btn${g === 'All' ? ' active' : ''}" data-genre="${g}">${g}</button>`
  ).join('');

  bar.addEventListener('click', e => {
    const btn = e.target.closest('.genre-btn');
    if (!btn) return;
    bar.querySelectorAll('.genre-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    onSelect(btn.dataset.genre);
  });
}

// ────────────────────────────────────────────────────────────
// RENDER: HOME
// ────────────────────────────────────────────────────────────
function renderHome() {
  const tGrid = document.getElementById('trending-grid');
  const pGrid = document.getElementById('popular-grid');
  tGrid.innerHTML = buildSkeletons(5);
  pGrid.innerHTML = buildSkeletons(6);

  // Simulate brief data load
  setTimeout(() => {
    tGrid.innerHTML = getTrending().map(a => buildCard(a)).join('');
    pGrid.innerHTML = getPopular().map(a => buildCard(a)).join('');
    attachCardListeners(tGrid);
    attachCardListeners(pGrid);
  }, 300);

  // Continue Watching
  renderContinueWatching();

  // Genre filter (home)
  buildGenreFilter('genre-filter-bar', genre => {
    const filtered = filterByGenre(genre);
    const tFiltered = filtered.filter(a => a.trending);
    const pFiltered = filtered.filter(a => a.popular);
    document.getElementById('trending-grid').innerHTML = tFiltered.length
      ? tFiltered.map(a => buildCard(a)).join('')
      : '<p class="search-no-results">No anime in this genre.</p>';
    document.getElementById('popular-grid').innerHTML = pFiltered.length
      ? pFiltered.map(a => buildCard(a)).join('')
      : '<p class="search-no-results">No anime in this genre.</p>';
    attachCardListeners(document.getElementById('trending-grid'));
    attachCardListeners(document.getElementById('popular-grid'));
  });
}

function renderContinueWatching() {
  const section = document.getElementById('section-continue');
  const grid = document.getElementById('continue-grid');
  if (!State.continueWatching.length) {
    section.style.display = 'none';
    return;
  }
  section.style.display = '';
  grid.innerHTML = State.continueWatching.map(item => {
    const anime = getAnimeById(item.id);
    if (!anime) return '';
    return buildCard(anime, { progress: item.progress });
  }).join('');
  attachCardListeners(grid);
}

// ────────────────────────────────────────────────────────────
// RENDER: POPULAR PAGE
// ────────────────────────────────────────────────────────────
function renderPopularPage() {
  const grid = document.getElementById('popular-page-grid');
  grid.innerHTML = buildSkeletons(8);

  buildGenreFilter('popular-genre-filter', genre => {
    const filtered = filterByGenre(genre);
    grid.innerHTML = filtered.map(a => buildCard(a)).join('');
    attachCardListeners(grid);
  });

  setTimeout(() => {
    grid.innerHTML = getPopular().map(a => buildCard(a)).join('');
    attachCardListeners(grid);
  }, 250);
}

// ────────────────────────────────────────────────────────────
// RENDER: MOVIES PAGE
// ────────────────────────────────────────────────────────────
function renderMoviesPage() {
  const movies = ANIME_DB.filter(a => a.type === 'Movie');
  const grid = document.getElementById('movies-grid');
  const empty = document.getElementById('movies-empty');
  if (movies.length === 0) {
    grid.innerHTML = '';
    empty.style.display = 'flex';
  } else {
    empty.style.display = 'none';
    grid.innerHTML = movies.map(a => buildCard(a)).join('');
    attachCardListeners(grid);
  }
}

// ────────────────────────────────────────────────────────────
// RENDER: SERIES PAGE
// ────────────────────────────────────────────────────────────
function renderSeriesPage() {
  const grid = document.getElementById('series-grid');
  grid.innerHTML = buildSkeletons(6);

  buildGenreFilter('series-genre-filter', genre => {
    const filtered = filterByGenre(genre).filter(a => a.type === 'TV');
    grid.innerHTML = filtered.length
      ? filtered.map(a => buildCard(a)).join('')
      : '<p class="search-no-results">No series found for this genre.</p>';
    attachCardListeners(grid);
  });

  setTimeout(() => {
    const series = ANIME_DB.filter(a => a.type === 'TV');
    grid.innerHTML = series.map(a => buildCard(a)).join('');
    attachCardListeners(grid);
  }, 250);
}

// ────────────────────────────────────────────────────────────
// RENDER: WATCHLIST PAGE
// ────────────────────────────────────────────────────────────
function renderWatchlistPage() {
  const grid = document.getElementById('watchlist-grid');
  const empty = document.getElementById('watchlist-empty');
  if (!State.watchlist.length) {
    grid.innerHTML = '';
    empty.style.display = 'flex';
  } else {
    empty.style.display = 'none';
    const items = State.watchlist.map(id => getAnimeById(id)).filter(Boolean);
    grid.innerHTML = items.map(a => buildCard(a)).join('');
    attachCardListeners(grid);
  }
}

// ────────────────────────────────────────────────────────────
// RENDER: SEARCH RESULTS PAGE
// ────────────────────────────────────────────────────────────
function renderSearchPage(query) {
  document.getElementById('search-query-label').textContent = query;
  const grid = document.getElementById('search-results-grid');
  const empty = document.getElementById('search-empty');
  const results = searchAnime(query);
  if (!results.length) {
    grid.innerHTML = '';
    empty.style.display = 'flex';
  } else {
    empty.style.display = 'none';
    grid.innerHTML = results.map(a => buildCard(a)).join('');
    attachCardListeners(grid);
  }
}

// ────────────────────────────────────────────────────────────
// RENDER: DETAIL PAGE
// ────────────────────────────────────────────────────────────
