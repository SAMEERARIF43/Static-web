      </div>`;
    attachNavListeners(container);
    return;
  }

  const episodes = getEpisodes(anime);
  const recommendations = getRecommendations(id, 4);
  const saved = isInWatchlist(id);

  container.innerHTML = `
    <div class="detail-banner">
      <img src="${anime.banner}"
           alt="${anime.title} banner"
           onerror="this.src='https://placehold.co/1280x480/0d1117/ff7200?text=${encodeURIComponent(anime.title)}'">
      <div class="detail-banner-overlay"></div>
    </div>
    <div class="detail-content">
      <button class="back-btn" id="detail-back">← Back</button>
      <div class="detail-top">
        <img class="detail-poster"
             src="${anime.poster}"
             alt="${anime.title} poster"
             onerror="this.src='https://placehold.co/300x450/0d1117/ff7200?text=${encodeURIComponent(anime.title)}'">
        <div class="detail-info">
          <h1 class="detail-title">${anime.title}</h1>
          <div class="detail-tags">
            ${anime.genres.map(g => `<span class="detail-tag genre-tag">${g}</span>`).join('')}
            <span class="detail-tag">${anime.studio}</span>
            <span class="detail-tag">${anime.year}</span>
          </div>
          <div class="detail-meta-row">
            <span><b>Type:</b> ${anime.type}</span>
            <span><b>Status:</b> ${anime.status}</span>
            <span><b>Episodes:</b> ${anime.episodes}</span>
          </div>
          <div class="detail-rating">⭐ ${anime.rating} <span style="font-size:14px;color:var(--text-muted);font-weight:400">/ 5.0</span></div>
          <div class="detail-actions">
            <button class="cta-btn primary-btn" id="detail-watch-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Watch Now
            </button>
            <button class="cta-btn secondary-btn" id="detail-watchlist-btn"
                    data-watchlist-id="${anime.id}"
                    style="gap:8px">
              ${saved ? '🔖 In Watchlist' : '🔖 Add to Watchlist'}
            </button>
          </div>
          <p class="detail-description">${anime.description}</p>
        </div>
      </div>

      <div class="episodes-section">
        <h2 class="episodes-title">Episodes</h2>
        <div class="episode-list">
          ${episodes.map(ep => `
            <div class="episode-item" data-ep="${ep.number}" role="button" tabindex="0" aria-label="Episode ${ep.number}">
              <span class="ep-num">Ep ${ep.number}</span>
              <span class="ep-title">${ep.title}</span>
              <span class="ep-dur">${ep.duration}</span>
            </div>`).join('')}
          ${anime.episodes > 24 ? `<div class="episode-item" style="opacity:0.5;cursor:default">+ ${anime.episodes - 24} more…</div>` : ''}
