const { test, expect } = require('@playwright/test');

/**
 * Regression test for search cache behavior on network failure.
 * Verifies that a failed search invalidates the cache so a retry fetches fresh data.
 */

const ONE_PIECE_FIXTURE = {
  id: 21,
  anilistId: 21,
  title: { english: 'ONE PIECE', romaji: 'One Piece', native: 'ONE PIECE' },
  coverImage: { extraLarge: 'https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx21-ELSYx3yMPcKM.jpg', large: 'https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx21-ELSYx3yMPcKM.jpg' },
  bannerImage: null,
  description: 'Fixture for One Piece.',
  episodes: 1100,
  status: 'RELEASING',
  averageScore: 85,
  genres: ['Action'],
  season: 'WINTER',
  seasonYear: 2024,
  format: 'TV',
  countryOfOrigin: 'JP',
  studios: { nodes: [{ name: 'Toei Animation' }] },
  staff: { edges: [] },
  characters: { edges: [] },
  relations: { edges: [] },
  recommendations: { edges: [] },
  trailer: null
};

function searchResults(query) {
  const q = query.toLowerCase();
  if (q.includes('one piece')) return [ONE_PIECE_FIXTURE];
  return [];
}

test.describe('Search Cache Behavior on Network Failure', () => {
  test.beforeEach(async ({ page }) => {
    await page.route('**/*', route => {
      const { hostname } = new URL(route.request().url());
      if (hostname === 'localhost' || hostname === '127.0.0.1') return route.continue();
      return route.abort();
    });

    // Mock /api/search to return deterministic fixtures instantly
    await page.route('**/api/search*', route => {
      const url = new URL(route.request().url());
      const query = url.searchParams.get('q') || '';
      route.fulfill({
        status: 200,
        contentType: 'application/json',
        body: JSON.stringify(searchResults(query))
      });
    });

    await page.goto('/', { waitUntil: 'domcontentloaded', timeout: 60000 });
  });

  test('First search failure does not cache error; retry succeeds', async ({ page }) => {
    // Step 1: First search with network failure (no cache entry yet)
    let failFirst = true;
    await page.route('**/api/search*', route => {
      if (failFirst) {
        failFirst = false;
        return route.abort('failed');
      }
      const url = new URL(route.request().url());
      const query = url.searchParams.get('q') || '';
      route.fulfill({
        status: 200,
        contentType: 'application/json',
        body: JSON.stringify(searchResults(query))
      });
    });
    
    // First search attempt - should fail
    await page.fill('#hero-search-input', 'One Piece');
    await page.keyboard.press('Enter');
    
    // Wait for error state
    await expect(page.locator('#search-error')).toBeVisible({ timeout: 15000 });
    await expect(page.locator('#search-error-message')).toContainText('Could not load search results');
    
    // Step 2: Retry - network now works, should succeed
    failFirst = false;
    await page.click('#search-retry-btn');
    
    // Wait for results to load
    await expect(page.locator('#search-results-grid .anime-card')).toBeVisible({ timeout: 15000 });
    
    // Verify fresh results appear
    const retryCard = page.locator('#search-results-grid .anime-card .card-title').first();
    await expect(retryCard).toBeVisible({ timeout: 15000 });
    const retryTitle = await retryCard.textContent();
    expect(retryTitle).toContain('ONE PIECE');
  });

  test('Failed search after cached success invalidates cache; retry fetches fresh', async ({ page }) => {
    // Step 1: Successful search - populates cache
    await page.fill('#hero-search-input', 'One Piece');
    await page.keyboard.press('Enter');
    await expect(page.locator('#page-search')).toHaveClass(/active/, { timeout: 30000 });
    await page.waitForSelector('#search-results-grid .anime-card', { timeout: 30000 });
    
    // Verify results appear
    const firstCard = page.locator('#search-results-grid .anime-card .card-title').first();
    await expect(firstCard).toBeVisible({ timeout: 15000 });
    const firstTitle = await firstCard.textContent();
    expect(firstTitle).toContain('ONE PIECE');
    
    // Step 2: Manually clear the search cache to simulate cache expiration/invalidation
    // This simulates the cache being invalidated (e.g., by a previous error)
    await page.evaluate(() => {
      window.searchCache = new Map();
    });
    
    // Step 3: Simulate network failure on subsequent search
    await page.route('**/api/search*', route => route.abort('failed'));
    
    // Step 4: Trigger a search that will fail (cache was cleared, so network request is made)
    await page.fill('#hero-search-input', 'One Piece');
    await page.keyboard.press('Enter');
    
    // Wait for error state
    await expect(page.locator('#search-error')).toBeVisible({ timeout: 15000 });
    await expect(page.locator('#search-error-message')).toContainText('Could not load search results');
    
    // Step 5: Retry the search - network now works
    await page.route('**/api/search*', route => {
      const url = new URL(route.request().url());
      const query = url.searchParams.get('q') || '';
      route.fulfill({
        status: 200,
        contentType: 'application/json',
        body: JSON.stringify(searchResults(query))
      });
    });
    
    await page.click('#search-retry-btn');
    
    // Wait for results to load
    await expect(page.locator('#search-results-grid .anime-card')).toBeVisible({ timeout: 15000 });
    
    // Verify fresh results appear
    const retryCard = page.locator('#search-results-grid .anime-card .card-title').first();
    await expect(retryCard).toBeVisible({ timeout: 15000 });
    const retryTitle = await retryCard.textContent();
    expect(retryTitle).toContain('ONE PIECE');
  });
});

function searchResults(query) {
  const q = query.toLowerCase();
  if (q.includes('one piece')) return [{
    id: 21,
    anilistId: 21,
    title: { english: 'ONE PIECE', romaji: 'One Piece', native: 'ONE PIECE' },
    coverImage: { extraLarge: 'https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx21-ELSYx3yMPcKM.jpg', large: 'https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx21-ELSYx3yMPcKM.jpg' },
    bannerImage: null,
    description: 'One Piece is a test fixture.',
    episodes: 1100,
    status: 'RELEASING',
    averageScore: 85,
    genres: ['Action'],
    season: 'WINTER',
    seasonYear: 2024,
    format: 'TV',
    countryOfOrigin: 'JP',
    studios: { nodes: [{ name: 'Toei Animation' }] },
    staff: { edges: [] },
    characters: { edges: [] },
    relations: { edges: [] },
    recommendations: { edges: [] },
    trailer: null
  }];
  return [];
}