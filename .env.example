# Anime Hub Server Configuration
# Set these as environment variables in your shell or hosting provider.
# The server does not load .env files automatically.

# Server port (default: 3000)
PORT=3000

# Comma-separated list of allowed CORS origins
# Default: http://localhost:<PORT>
# Add every public site origin when deploying.
CORS_ORIGINS=http://localhost:3000

# Public canonical site origin used by sitemap.xml and robots.txt
# Set this to the real HTTPS origin in production.
SITE_URL=

# Configure and monitor real addresses before publishing the legal pages.
CONTACT_EMAIL=
DMCA_EMAIL=
