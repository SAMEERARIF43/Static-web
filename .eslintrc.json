{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "ignorePatterns": ["/frontend/"],
  "overrides": [
    {
      "files": ["tests/**/*.test.js"],
      "env": { "jest": true, "node": true }
    }
  ],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-console": "off",
    "no-undef": "error"
  }
}
